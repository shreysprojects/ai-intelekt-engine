# ai-InteleKt Content Engine — environment configuration (placeholders only;
# copy to `.env` and fill in real values; `.env` is git-ignored, never commit keys)

# ---------- Video provider selection ----------
# mock = free simulation (default) | heygen = primary | tavus = fallback
VIDEO_PROVIDER=mock
VIDEO_FALLBACK_PROVIDER=tavus

# ---------- Provider credentials (server-side only, never sent to the browser) ----------
# HeyGen (primary): create at app.heygen.com → Settings → API
HEYGEN_API_KEY=
# Generic key applied to whichever provider is selected (optional alternative)
VIDEO_PROVIDER_API_KEY=
# Tavus (fallback): create at platform.tavus.io
TAVUS_API_KEY=

# ---------- Webhooks (optional — polling is the default for local use) ----------
# Secret returned once when registering a HeyGen webhook endpoint (POST /v3/webhooks/endpoints)
VIDEO_PROVIDER_WEBHOOK_SECRET=
# Public HTTPS base URL of THIS server if exposed (e.g. via a tunnel); enables callback_url
VIDEO_WEBHOOK_PUBLIC_URL=

# ---------- Behaviour ----------
VIDEO_PROVIDER_BASE_URL=
VIDEO_PROVIDER_POLL_INTERVAL_SECONDS=15
VIDEO_DEFAULT_ASPECT_RATIO=16:9
VIDEO_DEFAULT_RESOLUTION=1080p
VIDEO_CAPTIONS_ENABLED=true
VIDEO_COST_WARNING_THRESHOLD=
VIDEO_MONTHLY_HARD_LIMIT=

# ---------- Persona defaults (provider avatar/voice IDs; also editable in the UI) ----------
RAVI_VIDEO_AVATAR_ID=
RIK_VIDEO_AVATAR_ID=
PRODUCT_VIDEO_AVATAR_ID=
RAVI_VIDEO_VOICE_ID=
RIK_VIDEO_VOICE_ID=
PRODUCT_VIDEO_VOICE_ID=
